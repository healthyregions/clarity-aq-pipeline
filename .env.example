# Parameters to fetch from Clarity API
CLARITY_API_KEY=
CLARITY_ORG_NAME=cityof58A9

# Parameters for controlling data fetch output
RAW_DATA_OUTPUT_PATH=/usr/app/data/raw.csv

# Optional output of locations list (disabled by default)
OUTPUT_LOCATIONS_AS_JSON=true
LOCATIONS_OUTPUT_PATH=/usr/app/data/locations.json


# Parameters for S3 upload destination
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=chicago-aq

# use default endpoint for AWS S3
# uncomment for MinIO (e.g. http://localhost:9000)
# S3_ENDPOINT_URL=http://localhost:9000

# if using default endpoint, you should specify a region
# this parameter is ignored if a custom ENDPOINT_URL is provided
S3_REGION=us-east-2

# Local directory that will be uploaded to the bucket
LOCAL_OUTPUT_DIR=/usr/app/data

# Destination directory within the bucket
# Use UPLOAD_PATH if given, otherwise use timestamp: 2025-10-02@16:41:25
# S3_UPLOAD_PATH=''


# (optional) MinIO deployment for local development
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
